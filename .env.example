# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mandalbook?retryWrites=true&w=majority
MONGODB_DB_NAME=mandalbook

# Authentication (Google OAuth 2.0 + Gmail OTP)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
NEXTAUTH_SECRET=your-secure-nextauth-secret-key
NEXTAUTH_URL=https://new-yuwa-boys-mandal-book.vercel.app

# Media & Document Cloud Storage (Cloudinary)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Payments & WhatsApp Configuration
NEXT_PUBLIC_DEFAULT_UPI_ID=9923092340@ybl
NEXT_PUBLIC_DEFAULT_PHONE=7499085045
NEXT_PUBLIC_APP_URL=https://new-yuwa-boys-mandal-book.vercel.app

# Firebase Phone Auth & Services
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
