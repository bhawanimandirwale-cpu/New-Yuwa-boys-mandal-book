# MandalBook Environment Variables

# Local Database (Default: Zero-config SQLite for instant local execution)
# To use Supabase or PostgreSQL: "postgresql://postgres:password@db.supabase.co:5432/postgres"
DATABASE_URL="file:./dev.db"

# Public App URL (Always local fallback so dev never breaks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Cloud Storage (Cloudinary for bill & permit uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional Supabase Integration (if hosted)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
